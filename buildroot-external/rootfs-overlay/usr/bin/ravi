#!/bin/sh
# RaviOS Application Manager (CLI + Runtime)
#
# Manifest-driven application execution as specified in
# docs/development/application-manifast.md.
#
# Design goals:
#   - Zero per-application shell launch scripts.
#   - Any image that ships a valid app.json is startable via its cli_name.
#   - Typing the cli_name (e.g. "chromium") works because /usr/bin/<cli_name>
#     is a symlink to this binary; argv[0] selects the app automatically.
#   - All resource resolution goes through modular providers.
#   - Security baseline is applied uniformly; no CAP_SYS_ADMIN / no-sandbox.

set -eu

# ---------------------------------------------------------------------------
# Library
# ---------------------------------------------------------------------------
RUNTIME_LIB="/usr/libexec/ravios/app-runtime.sh"
if [ ! -f "$RUNTIME_LIB" ]; then
    echo "ravi: runtime library missing: $RUNTIME_LIB" >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$RUNTIME_LIB"


# Create a CLI alias on the live system (symlink). Not used inside the repo overlay.
install_cli_trampoline() {
    _dest="$1"
    [ -n "$_dest" ] || return 0
    if [ -e "$_dest" ] && [ ! -L "$_dest" ]; then
        return 0
    fi
    ln -sfn ravi "$_dest" 2>/dev/null || true
}


# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    cat <<'USAGE'
Usage: ravi <command> [args]
       <cli_name> [--temp|--logs]

Commands:
  list              List discovered apps and their status
  status [app]      Show status for one app or all apps
  start <app> [--temp]  Start app (--temp = no persistent volumes)
  stop <app>        Stop a running app container
  restart <app>     Stop then start
  remove <app>      Stop and remove the container (volumes kept)
  logs <app>        Show the last 33 lines of container logs
  import <image>    Materialise a customisable manifest (copy of system template)
                    Options: --name <cli_name>  |  --update
  import --scan     List local images still using the live default template
                    Options: --yes  (materialise all)
  refresh [--force] Scan local Docker images; create missing manifests + CLI links
                    --force re-writes manifests with version "auto" from template
  install-cli       Create /usr/bin/<cli_name> symlinks for every app

Flags (symlink or start):
  --temp            Stateless run (skip persistent volumes)
  --logs            Show last 33 log lines and exit

Default shared network: ravios-net
Default persistent volume: ravios-data-<cli_name> -> /data

Images without their own manifest use /etc/ravios/app-template.json live.
import materialises a private copy you can edit per image.
USAGE
}

# ---------------------------------------------------------------------------
# list / status
# ---------------------------------------------------------------------------
cmd_list() {
    printf "%-16s %-14s %-10s %-10s %s\n" "APP" "CONTAINER" "STATE" "SOURCE" "VERSION"
    seen=""

    # 1) Explicit manifests under SEED_ROOT
    if [ -d "$SEED_ROOT" ]; then
        for dir in "$SEED_ROOT"/*; do
            [ -f "$dir/app.json" ] || continue
            name="$(json_get "$dir/app.json" name 2>/dev/null || basename "$dir")"
            ver="$(json_get "$dir/app.json" version 2>/dev/null || echo "-")"
            container="$(json_get "$dir/app.json" container 2>/dev/null || echo "-")"
            if [ "$container" = "-" ] || [ -z "$container" ]; then
                state="n/a"
            elif docker_ready; then
                state="$(container_state "$container")"
            else
                state="?"
            fi
            printf "%-16s %-14s %-10s %-10s %s\n" "$name" "$container" "$state" "manifest" "$ver"
            seen="$seen $name"
        done
    fi

    # 2) Local images that use the live system default template
    if docker_ready; then
        docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null |             grep -v ':<none>$' | grep -v '^<none>' | sort -u | while IFS= read -r img; do
            [ -n "$img" ] || continue
            cli="$(sanitize_cli_name "$img")"
            case " $seen " in
                *" $cli "*) continue ;;
            esac
            # skip if any seed manifest already owns this image
            skip=false
            if [ -d "$SEED_ROOT" ]; then
                for dir in "$SEED_ROOT"/*; do
                    [ -f "$dir/app.json" ] || continue
                    existing="$(json_get "$dir/app.json" image 2>/dev/null || true)"
                    [ "$existing" = "$img" ] && skip=true && break
                done
            fi
            $skip && continue
            state="-"
            if docker_ready; then
                state="$(container_state "$cli")"
            fi
            printf "%-16s %-14s %-10s %-10s %s\n" "$cli" "$cli" "$state" "default" "auto"
        done
    fi
}

cmd_status() {
    app="${1:-}"
    if [ -z "$app" ]; then
        cmd_list
        return
    fi
    dir="$(resolve_app_dir "$app")" || { err "unknown app: $app (no manifest and no matching local image)"; return 1; }
    json="$dir/app.json"
    name="$(json_get "$json" name)"
    image="$(json_get "$json" image)"
    container="$(json_get "$json" container)"
    ver="$(json_get "$json" version)"
    autostart="$(json_get "$json" autostart 2>/dev/null || echo false)"
    cli="$(json_get "$json" cli_name 2>/dev/null || echo "$name")"

    echo "name:       $name"
    echo "cli_name:   $cli"
    echo "version:    $ver"
    echo "image:      $image"
    echo "container:  $container"
    echo "autostart:  $autostart"
    case "$dir" in
        /tmp/ravios-virt-*) echo "source:     default-template (/etc/ravios/app-template.json)" ;;
        *)                  echo "source:     manifest ($dir)" ;;
    esac

    display="$(json_resource_bool "$json" display 2>/dev/null || echo false)"
    gpu="$(json_resource_bool "$json" gpu 2>/dev/null || echo false)"
    audio="$(json_resource_bool "$json" audio 2>/dev/null || echo false)"
    echo "resources:  display=$display gpu=$gpu audio=$audio"

    if docker_ready && [ -n "$container" ]; then
        echo "state:      $(container_state "$container")"
        if docker image inspect "$image" >/dev/null 2>&1; then
            echo "image_loaded: yes"
        else
            echo "image_loaded: no"
        fi
    fi
}

# ---------------------------------------------------------------------------
# start – fully generic path (no special cases for any application)
# ---------------------------------------------------------------------------
cmd_start() {
    app="${1:-}"
    [ -n "$app" ] || { usage; return 1; }

    # Host baseline: video/render/audio must exist before any provider runs
    ensure_ravios_host_groups 2>/dev/null || true

    dir="$(resolve_app_dir "$app")" || { err "unknown app: $app (no manifest and no matching local image)"; return 1; }

    # First successful resolution of a local image: expose /usr/bin/<cli>
    # so the next time the user can type the short name directly.
    _cli="$(json_get "$dir/app.json" cli_name 2>/dev/null || true)"
    [ -n "$_cli" ] || _cli="$app"
    if [ -n "$_cli" ] && [ ! -e "/usr/bin/$_cli" ]; then
        install_cli_trampoline "/usr/bin/$_cli"
    fi
    json="$dir/app.json"
    image_tar="$dir/image.tar"

    if ! docker_ready; then
        err "Docker is not ready"
        return 1
    fi

    name="$(json_get "$json" name)"
    image="$(json_get "$json" image)"
    container="$(json_get "$json" container)"
    restart="$(json_get "$json" restart 2>/dev/null || echo unless-stopped)"
    want_rm="$(json_get "$json" rm 2>/dev/null || echo false)"
    want_interactive="$(json_get "$json" interactive 2>/dev/null || echo false)"
    temp_mode="${RAVIOS_TEMP:-0}"

    # ---- Dependency ordering (depth-limited) ----
    _dep_depth=${RAVIOS_APP_DEP_DEPTH:-0}
    if [ "$_dep_depth" -lt 5 ]; then
        for dep in $(json_get_array "$json" depends_on 2>/dev/null || true); do
            [ -n "$dep" ] || continue
            log "ensuring dependency '$dep' is started first ..."
            if ! env RAVIOS_APP_DEP_DEPTH=$((_dep_depth + 1)) \
                    /usr/bin/ravi start "$dep"; then
                warn "dependency '$dep' failed — continuing with $app anyway"
            fi
            sleep 1
        done
    fi

    # Re-resolve after dependencies
    dir="$(resolve_app_dir "$app")" || { err "unknown app after deps: $app"; return 1; }
    json="$dir/app.json"
    image_tar="$dir/image.tar"
    name="$(json_get "$json" name)"
    image="$(json_get "$json" image)"
    container="$(json_get "$json" container)"
    restart="$(json_get "$json" restart 2>/dev/null || echo unless-stopped)"
    want_rm="$(json_get "$json" rm 2>/dev/null || echo false)"
    want_interactive="$(json_get "$json" interactive 2>/dev/null || echo false)"
    temp_mode="${RAVIOS_TEMP:-0}"

    # ---- Image load ----
    if ! docker image inspect "$image" >/dev/null 2>&1; then
        if [ -s "$image_tar" ]; then
            log "loading $image_tar ..."
            docker load -i "$image_tar" || { err "docker load failed"; return 1; }
            rm -f "$image_tar"
        else
            err "image $image not loaded and no seed tar at $image_tar"
            return 1
        fi
    fi

    [ -n "$container" ] || { err "no container name in manifest"; return 1; }

    log "starting app=$name container=$container image=$image"
    state="$(container_state "$container")"
    if [ "$state" = "running" ]; then
        log "$container already running"
        return 0
    fi
    if [ "$state" = "stopped" ]; then
        # For apps that use --rm the container should not exist in stopped state,
        # but handle it gracefully.
        if docker start "$container" 2>/dev/null; then
            log "started existing container $container"
            return 0
        fi
        # Fall through to create if start failed
        docker rm -f "$container" 2>/dev/null || true
    fi

    # ---- Offline model seed (Ollama etc.) + pre-start ----
    if [ "$temp_mode" != "1" ]; then
        seed_model_archive "$json" "$dir" 2>/dev/null || true
        run_pre_start "$json" "$image"
    fi

    # ---- Resolve resources via providers ----
    PROVIDER_OUT="$(resolve_resources "$json" "$name" 2>/tmp/ravios-prov-err.$$)" || {
        cat /tmp/ravios-prov-err.$$ >&2 2>/dev/null || true
        rm -f /tmp/ravios-prov-err.$$
        err "resource resolution failed for $name"
        return 1
    }
    rm -f /tmp/ravios-prov-err.$$

    # ---- Build docker run argument list ----
    argfile="/tmp/ravios-app-args.$$"
    : > "$argfile"

    add_arg() {
        printf '%s\n' "$1" >> "$argfile"
    }

    add_arg "run"

    _tty=false
    [ -t 0 ] && [ -t 1 ] && _tty=true
    _do_interactive=false
    if [ "${want_interactive:-false}" = "true" ] && [ "$_tty" = "true" ] && [ "${RAVIOS_LOGS:-0}" != "1" ]; then
        _do_interactive=true
    fi

    if [ "$_do_interactive" = "true" ]; then
        # TTY attach: image default CMD stays in foreground (REPL/shell)
        add_arg "-it"
        add_arg "--rm"
    else
        add_arg "-d"
        if [ "$want_rm" = "true" ]; then
            add_arg "--rm"
        else
            add_arg "--restart"
            add_arg "$restart"
        fi
    fi

    add_arg "--name"
    add_arg "$container"

    # Security baseline – applied to every container
    for sarg in $(security_baseline_args); do
        add_arg "$sarg"
    done

    # Parse provider output
    echo "$PROVIDER_OUT" | while IFS= read -r line; do
        case "$line" in
            ENV:*)     printf 'ENV %s\n' "${line#ENV:}" ;;
            VOLUME:*)  printf 'VOL %s\n' "${line#VOLUME:}" ;;
            DEVICE:*)  printf 'DEV %s\n' "${line#DEVICE:}" ;;
            GROUP:*)   printf 'GRP %s\n' "${line#GROUP:}" ;;
            NETWORK:*) printf 'NET %s\n' "${line#NETWORK:}" ;;
            FLAG:*)    printf 'FLG %s\n' "${line#FLAG:}" ;;
        esac
    done > /tmp/ravios-parsed.$$

    while IFS= read -r p; do
        case "$p" in
            VOL\ *)
                if [ "$temp_mode" != "1" ]; then
                    add_arg "-v"
                    add_arg "${p#VOL }"
                fi
                ;;
            DEV\ *)
                add_arg "--device"
                add_arg "${p#DEV }"
                ;;
            GRP\ *)
                _g="${p#GRP }"
                if [ -n "$_g" ]; then
                    # Maps logical/standard names → host name or numeric GID.
                    # Never pass a name Docker cannot resolve on the host.
                    _resolved="$(resolve_docker_group "$_g" 2>/dev/null || true)"
                    if [ -n "$_resolved" ]; then
                        add_arg "--group-add"
                        add_arg "$_resolved"
                    else
                        warn "skipping unresolved group '$_g'"
                    fi
                fi
                ;;
            NET\ *)
                add_arg "--network"
                add_arg "${p#NET }"
                ;;
            FLG\ *)
                for f in ${p#FLG }; do
                    add_arg "$f"
                done
                ;;
            ENV\ *)
                add_arg "-e"
                add_arg "${p#ENV }"
                ;;
        esac
    done < /tmp/ravios-parsed.$$
    rm -f /tmp/ravios-parsed.$$

    # Legacy ports
    for p in $(json_get_array "$json" ports 2>/dev/null || true); do
        [ -n "$p" ] || continue
        add_arg "-p"
        add_arg "$p"
    done

    # Environment variables (static + from host + helpers)
    # Implemented in app-runtime.sh: apply_environment
    apply_environment "$json"

    # Optional resource limits / capabilities from manifest
    mem="$(json_get "$json" memory 2>/dev/null || true)"
    [ -n "$mem" ] && add_arg "--memory" && add_arg "$mem"
    cpus="$(json_get "$json" cpus 2>/dev/null || true)"
    [ -n "$cpus" ] && add_arg "--cpus" && add_arg "$cpus"
    for cap in $(json_get_array "$json" cap_add 2>/dev/null || true); do
        [ -n "$cap" ] && add_arg "--cap-add" && add_arg "$cap"
    done
    for cap in $(json_get_array "$json" cap_drop 2>/dev/null || true); do
        [ -n "$cap" ] && add_arg "--cap-drop" && add_arg "$cap"
    done

    # Image
    add_arg "$image"

    # Command + args from the manifest (if present)
    # This replaces every former per-app launch script.
    if json_command_args "$json" > /tmp/ravios-cmd.$$ 2>/dev/null; then
        while IFS= read -r carg; do
            [ -n "$carg" ] && add_arg "$carg"
        done < /tmp/ravios-cmd.$$
    fi
    rm -f /tmp/ravios-cmd.$$

    # ---- Execute ----
    cmd="docker"
    while IFS= read -r a; do
        q=$(printf "%s" "$a" | sed "s/'/'\\\\''/g")
        cmd="$cmd '$q'"
    done < "$argfile"
    rm -f "$argfile"

    log "creating container $container via generic runtime"
    if [ "${_do_interactive:-false}" = "true" ]; then
        log "interactive session ($container) — exit the program/shell to return"
        eval "exec $cmd"
        return 1
    fi

    if eval "$cmd"; then
        sleep 2
        state="$(container_state "$container")"
        if [ "$state" = "running" ]; then
            log "started $container"
            return 0
        fi

        err "container '$container' is not running (state=$state) — process exited immediately"
        if docker container inspect "$container" >/dev/null 2>&1; then
            log "last logs for $container:"
            docker logs --tail 50 "$container" 2>&1 || true
            docker rm -f "$container" >/dev/null 2>&1 || true
        else
            err "container removed on exit (--rm). Use a TTY with interactive=true, or set a long-running command."
        fi
        return 1
    fi
    err "failed to create $container"
    return 1
}

# ---------------------------------------------------------------------------
# stop / remove
# ---------------------------------------------------------------------------
cmd_stop() {
    app="${1:-}"
    [ -n "$app" ] || { usage; return 1; }
    dir="$(resolve_app_dir "$app")" || { err "unknown app: $app (no manifest and no matching local image)"; return 1; }
    container="$(json_get "$dir/app.json" container)"
    [ -n "$container" ] || { err "no container in manifest"; return 1; }

    if [ "$(container_state "$container")" = "running" ]; then
        docker stop "$container" && log "stopped $container"
    else
        log "$container is not running"
    fi

    name="$(json_get "$dir/app.json" name)"
    for net in $(json_get_array "$dir/app.json" networks 2>/dev/null || true); do
        provider_network_release "$net" "$name" 2>/dev/null || true
    done
}

cmd_remove() {
    app="${1:-}"
    [ -n "$app" ] || { usage; return 1; }
    dir="$(resolve_app_dir "$app")" || { err "unknown app: $app (no manifest and no matching local image)"; return 1; }
    container="$(json_get "$dir/app.json" container)"
    [ -n "$container" ] || { err "no container in manifest"; return 1; }

    docker rm -f "$container" 2>/dev/null && log "removed container $container" || log "no container to remove"
    # Volumes and shared networks are intentionally left intact.
}


# ---------------------------------------------------------------------------
# logs – last 33 lines of a container log
# ---------------------------------------------------------------------------
cmd_logs() {
    app="${1:-}"
    [ -n "$app" ] || { usage; return 1; }
    dir="$(resolve_app_dir "$app")" || { err "unknown app: $app (no manifest and no matching local image)"; return 1; }
    container="$(json_get "$dir/app.json" container)"
    [ -n "$container" ] || { err "no container in manifest"; return 1; }
    if ! docker container inspect "$container" >/dev/null 2>&1; then
        err "container '$container' does not exist (start the app first)"
        return 1
    fi
    docker logs --tail 33 "$container" 2>&1
}

# ---------------------------------------------------------------------------
# import – materialise a private, customisable copy of the system template
# ---------------------------------------------------------------------------
# Images without an imported manifest use /etc/ravios/app-template.json live.
# import copies that template under SEED_ROOT so the app can diverge.

write_template_manifest() {
    # Thin wrapper around render_default_manifest (app-runtime.sh)
    dest_dir="$1"
    cli="$2"
    image_ref="$3"
    mkdir -p "$dest_dir"
    src="$(render_default_manifest "$cli" "$image_ref")"
    cp "$src" "$dest_dir/app.json"
}

cmd_import() {
    if ! docker_ready; then
        err "Docker is not ready"
        return 1
    fi

    # ---- --scan mode ----
    if [ "${1:-}" = "--scan" ]; then
        shift
        auto_yes=false
        [ "${1:-}" = "--yes" ] && auto_yes=true

        echo "Local Docker images without a RaviOS manifest:"
        echo "(default network for new imports: $RAVIOS_DEFAULT_NETWORK)"
        echo

        # List repo:tag (skip <none>)
        docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | \
            grep -v ':<none>$' | grep -v '^<none>' | sort -u | while IFS= read -r img; do
            [ -n "$img" ] || continue
            cli="$(sanitize_cli_name "$img")"
            if find_app_dir "$cli" >/dev/null 2>&1; then
                continue
            fi
            # Also skip if any existing manifest already points at this image
            already=false
            for dir in "$SEED_ROOT"/*; do
                [ -f "$dir/app.json" ] || continue
                existing="$(json_get "$dir/app.json" image 2>/dev/null || true)"
                if [ "$existing" = "$img" ]; then
                    already=true
                    break
                fi
            done
            $already && continue

            printf "  %-40s  → cli_name: %s\n" "$img" "$cli"
            if [ "$auto_yes" = true ]; then
                cmd_import "$img" --name "$cli" || true
            fi
        done

        if [ "$auto_yes" != true ]; then
            echo
            echo "Import one:  ravi import <image> [--name <cli_name>]"
            echo "Import all:  ravi import --scan --yes"
        fi
        return 0
    fi

    # ---- single image import ----
    image_ref="${1:-}"
    [ -n "$image_ref" ] || { usage; return 1; }
    shift

    cli=""
    do_update=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)
                cli="${2:-}"
                [ -n "$cli" ] || { err "--name requires a value"; return 1; }
                shift 2
                ;;
            --update)
                do_update=true
                shift
                ;;
            *)
                err "unknown option: $1"
                return 1
                ;;
        esac
    done

    [ -n "$cli" ] || cli="$(sanitize_cli_name "$image_ref")"
    [ -n "$cli" ] || { err "could not derive a cli_name from $image_ref"; return 1; }

    # Ensure image exists locally (pull if missing)
    if ! docker image inspect "$image_ref" >/dev/null 2>&1; then
        log "image not found locally; pulling $image_ref ..."
        if ! docker pull "$image_ref"; then
            err "failed to pull $image_ref"
            return 1
        fi
    fi

    dest="$SEED_ROOT/$cli"
    if [ -f "$dest/app.json" ]; then
        existing_img="$(json_get "$dest/app.json" image 2>/dev/null || true)"
        if [ "$do_update" = true ]; then
            tmp="$(mktemp)"
            sed "s|\"image\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"image\": \"$image_ref\"|"                 "$dest/app.json" > "$tmp" && mv "$tmp" "$dest/app.json"
            log "updated image for '$cli': $existing_img -> $image_ref"
            echo "cli_name: $cli"
            echo "manifest: $dest/app.json"
            echo "image:    $image_ref"
            return 0
        fi
        if [ "$existing_img" = "$image_ref" ]; then
            log "manifest already exists for $cli ($image_ref)"
            ensure_cli_links
            echo "cli_name: $cli"
            echo "manifest: $dest/app.json"
            return 0
        fi
        err "cli_name '$cli' is already used by image $existing_img"
        err "choose another name: ravi import $image_ref --name <other>"
        err "or update image only: ravi import $image_ref --name $cli --update"
        return 1
    fi

    # Ensure default shared network exists
    provider_network_ensure "$RAVIOS_DEFAULT_NETWORK" "shared" "$cli" >/dev/null 2>&1 || \
        docker network create "$RAVIOS_DEFAULT_NETWORK" >/dev/null 2>&1 || true

    write_template_manifest "$dest" "$cli" "$image_ref"
    ensure_cli_links

    log "imported $image_ref as '$cli'"
    echo "cli_name:  $cli"
    echo "manifest:  $dest/app.json"
    echo "network:   $RAVIOS_DEFAULT_NETWORK (shared default)"
    echo "volume:    ravios-data-$cli -> /data (persistent; use --temp to skip)"
    echo "start with: $cli   or   ravi start $cli"
    echo "edit:       $dest/app.json"
}


# ---------------------------------------------------------------------------
# refresh – after docker pull: materialise missing manifests + CLI symlinks
# ---------------------------------------------------------------------------
# Walks local images. For each image without a materialised app.json under
# SEED_ROOT, writes one from /etc/ravios/app-template.json and creates
# /usr/bin/<cli_name> → ravios-app so the user can type the short name.
cmd_refresh() {
    if ! docker_ready; then
        err "Docker is not ready"
        return 1
    fi

    force=false
    [ "${1:-}" = "--force" ] && force=true

    mkdir -p "$SEED_ROOT"
    created=0
    skipped=0
    updated=0
    linked=0

    echo "Refreshing RaviOS apps from local Docker images..."
    echo "template: $RAVIOS_APP_TEMPLATE"
    echo "seed:     $SEED_ROOT"
    echo

    # Collect images without using a pipeline subshell for counters
    _list="/tmp/ravios-refresh-images.$$"
    docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | \
        grep -v ':<none>$' | grep -v '^<none>' | sort -u > "$_list" || true

    while IFS= read -r img; do
        [ -n "$img" ] || continue
        cli="$(sanitize_cli_name "$img")"
        [ -n "$cli" ] || continue

        dest="$SEED_ROOT/$cli"
        has_manifest=false
        if [ -f "$dest/app.json" ]; then
            has_manifest=true
        else
            # Another directory may already claim this image
            for dir in "$SEED_ROOT"/*; do
                [ -f "$dir/app.json" ] || continue
                existing="$(json_get "$dir/app.json" image 2>/dev/null || true)"
                if [ "$existing" = "$img" ]; then
                    has_manifest=true
                    dest="$dir"
                    cli="$(json_get "$dir/app.json" cli_name 2>/dev/null || true)"
                    [ -n "$cli" ] || cli="$(basename "$dir")"
                    break
                fi
            done
        fi

        if [ "$has_manifest" = true ]; then
            ver="$(json_get "$dest/app.json" version 2>/dev/null || true)"
            if [ "$force" = true ] && [ "$ver" = "auto" ]; then
                write_template_manifest "$dest" "$cli" "$img"
                printf "  ~ updated   %-36s  cli=%s (auto)\n" "$img" "$cli"
                updated=$((updated + 1))
            else
                skipped=$((skipped + 1))
            fi
        else
            write_template_manifest "$dest" "$cli" "$img"
            printf "  + manifest  %-36s  cli=%s\n" "$img" "$cli"
            created=$((created + 1))
        fi

        # CLI symlink
        link="$CLI_LINK_DIR/$cli"
        if [ -L "$link" ] || [ -e "$link" ]; then
            :
        else
            install_cli_trampoline "$link"; linked=$((linked + 1))
        fi
        # Ensure link points at ravios-app when we own it / missing
        if [ ! -e "$link" ]; then
            install_cli_trampoline "$link"; linked=$((linked + 1))
        fi
    done < "$_list"
    rm -f "$_list"

    # Also refresh links for all seeded apps (including pre-existing)
    ensure_cli_links 2>/dev/null || true

    echo
    echo "Done: ${created} new, ${updated:-0} updated, ${skipped} skipped; CLI links refreshed."
    echo "Example:  python-3-14"
    echo "          ravi start python-3-14"
    echo "Edit:     $SEED_ROOT/<cli_name>/app.json"
}

# ---------------------------------------------------------------------------
# install-cli – create /usr/bin/<cli_name> → ravios-app symlinks
# ---------------------------------------------------------------------------
cmd_install_cli() {
    ensure_cli_links
    log "CLI links refreshed under $CLI_LINK_DIR"
    # Show what we have
    for dir in "$SEED_ROOT"/*; do
        [ -f "$dir/app.json" ] || continue
        cli="$(json_get "$dir/app.json" cli_name 2>/dev/null || true)"
        [ -n "$cli" ] || cli="$(json_get "$dir/app.json" name 2>/dev/null || true)"
        [ -n "$cli" ] || continue
        if [ -L "$CLI_LINK_DIR/$cli" ]; then
            echo "  $cli -> $(readlink "$CLI_LINK_DIR/$cli")"
        fi
    done
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
# Global flags:
#   --temp   → stateless run (no persistent volumes)
#   --logs   → show last 33 log lines and exit
parse_global_flags() {
    RAVIOS_TEMP=0
    RAVIOS_LOGS=0
    _kept=""
    for a in "$@"; do
        case "$a" in
            --temp) RAVIOS_TEMP=1 ;;
            --logs) RAVIOS_LOGS=1 ;;
            *) _kept="$_kept $a" ;;
        esac
    done
    export RAVIOS_TEMP RAVIOS_LOGS
    # Return remaining args via global
    RAVIOS_REMAINING_ARGS="$_kept"
}


# RAVI_ARGV0 is set by trampoline scripts (chromium, ollama, …) so we still
# know the user-facing name when those are regular files instead of symlinks.
invoked_as="${RAVI_ARGV0:-$(basename "$0")}"
unset RAVI_ARGV0
# Primary CLI is "ravi"; "ravios-app" remains a compatibility alias.
if [ "$invoked_as" != "ravi" ] && [ "$invoked_as" != "ravios-app" ]; then
    ensure_cli_links 2>/dev/null || true
    parse_global_flags "$@"
    if [ "$RAVIOS_LOGS" = "1" ]; then
        cmd_logs "$invoked_as"
        exit $?
    fi
    # No materialised manifest required: resolve_app_dir uses the live
    # system template for any local image without its own app.json.
    cmd_start "$invoked_as"
    exit $?
fi

cmd="${1:-}"
shift 2>/dev/null || true
parse_global_flags "$@"
# shellcheck disable=SC2086
set -- $RAVIOS_REMAINING_ARGS

case "$cmd" in
    list)        cmd_list ;;
    status)      cmd_status "$@" ;;
    start)
        if [ "$RAVIOS_LOGS" = "1" ]; then
            cmd_logs "${1:-}"
        else
            cmd_start "$@"
        fi
        ;;
    stop)        cmd_stop "$@" ;;
    restart)     cmd_stop "${1:-}"; cmd_start "${1:-}" ;;
    remove|rm)   cmd_remove "$@" ;;
    logs)        cmd_logs "$@" ;;
    import)      cmd_import "$@" ;;
    refresh)     cmd_refresh "$@" ;;
    install-cli) cmd_install_cli ;;
    -h|--help|help|"") usage ;;
    *)
        if resolve_app_dir "$cmd" >/dev/null 2>&1; then
            if [ "$RAVIOS_LOGS" = "1" ]; then
                cmd_logs "$cmd"
            else
                cmd_start "$cmd"
            fi
        else
            err "unknown command or app: $cmd"
            usage
            exit 1
        fi
        ;;
esac
