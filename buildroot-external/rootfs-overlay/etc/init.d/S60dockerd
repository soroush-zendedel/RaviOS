#!/bin/sh

DAEMON="dockerd"
PIDFILE="/var/run/$DAEMON.pid"

DATA_UUID="66666666-6666-6666-6666-666666666666"
DATA_LABEL="revayat"
MOUNTPOINT="/var/lib/docker"
STATUS_FILE="/var/lib/ravios/docker-data/status"

DOCKERD_ARGS=""

[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

check_docker_data() {
    printf "Checking Docker Data: "

    [ -r "$STATUS_FILE" ] || {
        echo "FAIL (status unavailable)"
        return 1
    }

    STATUS="$(awk -F= '$1 == "STATUS" {print $2}' "$STATUS_FILE")"
    DEVICE="$(awk -F= '$1 == "DEVICE" {print $2}' "$STATUS_FILE")"
    EXPECTED_DISK_ID="$(awk -F= '$1 == "DISK_ID" {print $2}' "$STATUS_FILE")"
    EXPECTED_PARTUUID="$(awk -F= '$1 == "PARTUUID" {print $2}' "$STATUS_FILE")"

    if [ "$STATUS" != "ready" ] ||
       [ -z "$DEVICE" ] ||
       [ -z "$EXPECTED_DISK_ID" ] ||
       [ -z "$EXPECTED_PARTUUID" ]; then
        echo "FAIL (storage is not ready)"
        return 1
    fi

    DEVICE_REAL="$(readlink -f "$DEVICE" 2>/dev/null)"

    if [ ! -b "$DEVICE_REAL" ]; then
        echo "FAIL (device missing)"
        return 1
    fi

    ACTUAL_PARTUUID="$(lsblk -ndo PARTUUID "$DEVICE_REAL" 2>/dev/null)"
    PARENT="$(lsblk -ndo PKNAME "$DEVICE_REAL" 2>/dev/null)"

    [ -n "$PARENT" ] || {
        echo "FAIL (parent disk unavailable)"
        return 1
    }

    case "$PARENT" in
        /dev/*) ;;
        *) PARENT="/dev/$PARENT" ;;
    esac

    PARENT_REAL="$(readlink -f "$PARENT" 2>/dev/null)"
    ACTUAL_DISK_ID="$(lsblk -ndo ID-LINK "$PARENT_REAL" 2>/dev/null)"

    if [ "$ACTUAL_PARTUUID" != "$EXPECTED_PARTUUID" ] ||
       [ "$ACTUAL_DISK_ID" != "$EXPECTED_DISK_ID" ]; then
        echo "FAIL (device identity mismatch)"
        return 1
    fi

    ACTUAL_UUID="$(blkid -p -s UUID -o value "$DEVICE_REAL" 2>/dev/null)"
    ACTUAL_TYPE="$(blkid -p -s TYPE -o value "$DEVICE_REAL" 2>/dev/null)"
    ACTUAL_LABEL="$(blkid -p -s LABEL -o value "$DEVICE_REAL" 2>/dev/null)"

    if [ "$ACTUAL_UUID" != "$DATA_UUID" ] ||
       [ "$ACTUAL_TYPE" != "ext4" ] ||
       [ "$ACTUAL_LABEL" != "$DATA_LABEL" ]; then
        echo "FAIL (invalid filesystem)"
        return 1
    fi

    MOUNT_INFO="$(awk -v mp="$MOUNTPOINT" '$2 == mp {print $1, $3; exit}' /proc/mounts)"

    if [ -z "$MOUNT_INFO" ]; then
        echo "FAIL (Docker Data is not mounted)"
        return 1
    fi

    set -- $MOUNT_INFO

    if [ "$#" -ne 2 ]; then
        echo "FAIL (invalid mount information)"
        return 1
    fi

    MOUNT_SOURCE="$(readlink -f "$1" 2>/dev/null)"
    MOUNT_TYPE="$2"

    if [ "$MOUNT_SOURCE" != "$DEVICE_REAL" ] || [ "$MOUNT_TYPE" != "ext4" ]; then
        echo "FAIL (wrong filesystem mounted)"
        return 1
    fi

    echo "OK"
    return 0
}

start() {
    if ! check_docker_data; then
        echo "Refusing to start Docker without valid Docker Data."
        return 1
    fi

    printf 'Starting %s: ' "$DAEMON"

    start-stop-daemon --start --background --pidfile "$PIDFILE" \
        --exec /usr/libexec/dockerd-syslog-wrapper.sh \
        -- "/usr/bin/$DAEMON" --pidfile "$PIDFILE" $DOCKERD_ARGS

    status=$?

    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi

    return "$status"
}

stop() {
    printf 'Stopping %s: ' "$DAEMON"

    start-stop-daemon --stop --pidfile "$PIDFILE" --exec "/usr/bin/$DAEMON"

    status=$?

    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
        return "$status"
    fi

    while start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
        --exec "/usr/bin/$DAEMON"; do
        sleep 0.1
    done

    rm -f "$PIDFILE"
    return "$status"
}

restart() {
    stop
    start
}

reload() {
    if ! check_docker_data; then
        echo "Refusing to reload Docker without valid Docker Data."
        return 1
    fi

    printf "Reloading %s config: " "$DAEMON"

    start-stop-daemon --stop --signal HUP -q --pidfile "$PIDFILE" \
        --exec "/usr/bin/$DAEMON"

    status=$?

    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi

    return "$status"
}

case "$1" in
    start|stop|restart|reload)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac
