#!/bin/sh
# Load and start ravios-webui (Open WebUI) after Docker and Ollama are ready.
# First boot loads the offline image; later boots reuse the existing container.
#
# Ordering: S70ollama runs first (lexical order), then this script.
# The container is created with --restart unless-stopped so Docker keeps it
# alive across reboots without re-running the full setup.

IMAGE="ravios-webui:latest"
CONTAINER="ravios-webui"
DATA_VOLUME="ravios-webui-data"
NETWORK="ravios-net"
OLLAMA_CONTAINER="ravi-ollama"

OFFLINE_DIR="/usr/share/ravios/offline/ravios-webui"
IMAGE_ARCHIVE="$OFFLINE_DIR/image/ravios-webui-image.tar"

SECRET_DIR="/var/lib/ravios/webui"
SECRET_FILE="$SECRET_DIR/secret_key"

wait_for_docker() {
    attempt=0
    until docker info >/dev/null 2>&1; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 30 ]; then
            return 1
        fi
        sleep 1
    done
    return 0
}

ensure_secret() {
    if [ -s "$SECRET_FILE" ]; then
        return 0
    fi
    mkdir -p "$SECRET_DIR"
    # 64 hex chars is sufficient for WEBUI_SECRET_KEY.
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex 32 > "$SECRET_FILE"
    else
        # Fallback when openssl is unavailable on the minimal host.
        tr -dc 'a-f0-9' < /dev/urandom | head -c 64 > "$SECRET_FILE"
    fi
    chmod 600 "$SECRET_FILE"
}

ensure_network() {
    if ! docker network inspect "$NETWORK" >/dev/null 2>&1; then
        docker network create "$NETWORK" >/dev/null || return 1
    fi

    # Attach the existing Ollama container if it is present and not already
    # connected. This does not recreate or modify the Ollama image.
    if docker container inspect "$OLLAMA_CONTAINER" >/dev/null 2>&1; then
        if ! docker inspect -f '{{json .NetworkSettings.Networks}}' "$OLLAMA_CONTAINER" \
            | grep -q "\"$NETWORK\""; then
            docker network connect "$NETWORK" "$OLLAMA_CONTAINER" >/dev/null 2>&1 || true
        fi
    fi
    return 0
}

start() {
    printf "Checking Docker Data: "

    STATUS="$(awk -F= '$1 == "STATUS" {print $2}' \
        /var/lib/ravios/docker-data/status 2>/dev/null)"

    if [ "$STATUS" != "ready" ] ||
       ! awk '$2 == "/var/lib/docker" && $3 == "ext4" {found=1} END {exit !found}' /proc/mounts; then
        echo "FAIL"
        echo "Error: Docker Data is unavailable."
        return 1
    fi

    echo "OK"

    printf "Waiting for Docker Engine: "
    if ! wait_for_docker; then
        echo "FAIL"
        echo "Error: Docker Engine is not ready."
        return 1
    fi
    echo "OK"

    printf "Checking WebUI Image: "
    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        if [ ! -s "$IMAGE_ARCHIVE" ]; then
            echo "FAIL"
            echo "Error: Offline WebUI image archive is missing."
            return 1
        fi
        echo "Loading offline image..."
        docker load -i "$IMAGE_ARCHIVE" || {
            echo "Error: Cannot load WebUI image."
            return 1
        }
    fi
    docker image inspect "$IMAGE" >/dev/null 2>&1 || {
        echo "Error: WebUI image is unavailable after loading."
        return 1
    }
    echo "OK"

    printf "Checking data volume: "
    if ! docker volume inspect "$DATA_VOLUME" >/dev/null 2>&1; then
        docker volume create "$DATA_VOLUME" >/dev/null || {
            echo "FAIL"
            echo "Error: Cannot create WebUI data volume."
            return 1
        }
    fi
    echo "OK"

    printf "Ensuring secret key: "
    ensure_secret || {
        echo "FAIL"
        echo "Error: Cannot create WEBUI_SECRET_KEY."
        return 1
    }
    SECRET_KEY="$(cat "$SECRET_FILE")"
    echo "OK"

    printf "Ensuring Docker network: "
    ensure_network || {
        echo "FAIL"
        echo "Error: Cannot prepare ravios-net."
        return 1
    }
    echo "OK"

    printf "Checking WebUI Container: "
    if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
        RUNNING="$(docker inspect --format '{{.State.Running}}' \
            "$CONTAINER" 2>/dev/null)"
        if [ "$RUNNING" != "true" ]; then
            docker start "$CONTAINER" >/dev/null || {
                echo "FAIL"
                echo "Error: Cannot start WebUI container."
                return 1
            }
        fi
        echo "OK"
    else
        echo "Creating container..."

        # OLLAMA_BASE_URL points at the Ollama container on the shared network.
        # HF_*_OFFLINE prevents HuggingFace downloads after boot (RaviOS is
        # offline-first). RAG embedding can be configured later to use Ollama.
        docker run -d \
            --name "$CONTAINER" \
            --restart unless-stopped \
            --network "$NETWORK" \
            -p 127.0.0.1:8080:8080 \
            -v "$DATA_VOLUME:/app/backend/data" \
            -e "WEBUI_SECRET_KEY=$SECRET_KEY" \
            -e "OLLAMA_BASE_URL=http://ravi-ollama:11434" \
            -e "ENV=prod" \
            -e "WEBUI_AUTH=false" \
            -e "HF_HUB_OFFLINE=1" \
            -e "TRANSFORMERS_OFFLINE=1" \
            -e "HF_DATASETS_OFFLINE=1" \
            -e "RAG_EMBEDDING_ENGINE=ollama" \
            -e "RAG_EMBEDDING_MODEL=qwen2.5:0.5b" \
            -e "HF_HUB_DISABLE_TELEMETRY=1" \
            -e "ANONYMIZED_TELEMETRY=False" \
            -e "DO_NOT_TRACK=1" \
            -e "SCARF_NO_ANALYTICS=true" \
            "$IMAGE" || {
                echo "Error: Cannot create WebUI container."
                return 1
            }
        echo "OK"
    fi

    echo "WebUI started successfully."
    return 0
}

case "$1" in
    start)
        start
        ;;
    *)
        echo "Usage: $0 start"
        exit 1
        ;;
esac
