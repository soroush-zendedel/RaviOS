config BR2_PACKAGE_RAVIOS_LIBADWAITA
    bool "libadwaita"
    depends on BR2_USE_MMU
    depends on BR2_USE_WCHAR
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on BR2_PACKAGE_LIBGTK4
    depends on BR2_PACKAGE_LIBGLIB2
    select BR2_PACKAGE_LIBFRIBIDI
    depends on BR2_PACKAGE_RAVIOS_APPSTREAM
    help
      GNOME adaptive UI library for GTK4.
      Required by GNOME desktop portal backend.
