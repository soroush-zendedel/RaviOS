config BR2_PACKAGE_RAVIOS_GNOME_DESKTOP
    bool "gnome-desktop"
    depends on BR2_USE_MMU
    depends on BR2_USE_WCHAR
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on BR2_PACKAGE_LIBGTK4
