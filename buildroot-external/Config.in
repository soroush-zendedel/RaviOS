source "$BR2_EXTERNAL_RAVIOS_PATH/package/ravios-appstream/Config.in"
source "$BR2_EXTERNAL_RAVIOS_PATH/package/ravios-iso-codes/Config.in"
source "$BR2_EXTERNAL_RAVIOS_PATH/package/ravios-xdg-desktop-portal/Config.in"
source "$BR2_EXTERNAL_RAVIOS_PATH/package/ravios-xdg-desktop-portal-gnome/Config.in"
