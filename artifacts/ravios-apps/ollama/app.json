{
  "name": "ollama",
  "cli_name": "ollama",
  "version": "1.2.0",
  "image": "ravi-ollama:cpu",
  "container": "ravi-ollama",
  "restart": "unless-stopped",
  "autostart": false,
  "load_priority": 20,
  "ports": [
    "11434:11434"
  ],
  "resources": {
    "display": false,
    "gpu": false,
    "audio": false,
    "networks": [
      {
        "name": "ravios-net",
        "mode": "shared"
      }
    ],
    "volumes": [
      {
        "name": "ravios-data-ollama",
        "target": "/models",
        "persistent": true
      }
    ]
  },
  "environment": {
    "OLLAMA_HOST": "0.0.0.0:11434",
    "OLLAMA_MODELS": "/models",
    "OLLAMA_NO_CLOUD": "true",
    "OLLAMA_NOPRUNE": "true",
    "OLLAMA_VULKAN": "false"
  },
  "extra": {
    "model_archive": "models/qwen2.5-0.5b.tar",
    "model_volume": "ravios-data-ollama",
    "model_manifest": "manifests/registry.ollama.ai/library/qwen2.5/0.5b"
  },
  "description": "RaviOS offline Ollama with Qwen 2.5 0.5B. Persistent models on ravios-data-ollama. Use --temp for a stateless run."
}
